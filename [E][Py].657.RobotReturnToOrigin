class Solution(object):
    def judgeCircle(self, moves):
        """
        :type moves: str
        :rtype: bool
        """
        x, y = 0, 0
        if len(moves) % 2 == 1:
            return False
        for m in moves:
            if m == 'U':
                y = y + 1
                continue
            if m == 'D':
                y = y - 1
                continue
            if m == 'L':
                x = x - 1
                continue
            if m == 'R':
                x = x + 1
                continue
        return x == 0 and y == 0
        
